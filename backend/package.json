{
  "name": "backend",
  "version": "4.1.0",
  "author": "seeeroy",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch --exec 'bun -r tsconfig-paths/register -r ts-node/register ./src/main.ts'",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/backend/src/main",
    "openapi:json": "bun -r tsconfig-paths/register ./scripts/generate-openapi.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental false",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:cov": "bun test src --coverage",
    "test:e2e": "bun test ./test/rbac.e2e-spec.ts ./test/full-lifecycle.e2e-spec.ts",
    "test:e2e:paper": "bun test --timeout 1800000 ./test/paper.e2e-spec.ts",
    "test:e2e:rbac": "bun test --timeout 1800000 ./test/rbac.e2e-spec.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@hloth/minecraft-query": "^1.0.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.8",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "@xhmikosr/decompress": "^11.1.4",
    "@xterm/headless": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bun-types": "^1.4.4",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compressing": "^2.1.3",
    "cron": "4.4.0",
    "dockerode": "^5.0.1",
    "ftpd": "^0.2.16",
    "grammy": "^1.46.0",
    "jimp": "^1.6.1",
    "ky": "^2.2.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "node-machine-id": "^1.1.12",
    "ora": "^9.4.1",
    "os-utils": "^0.0.14",
    "otplib": "^13.5.0",
    "pidusage": "^4.1.0",
    "public-ip": "^8.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kubekpanel/blueprint-sdk": "^0.2.0",
    "@kubekpanel/extension-sdk": "^0.1.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.4",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/os-utils": "^0.0.4",
    "@types/public-ip": "^3.1.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.4.1"
  }
}
